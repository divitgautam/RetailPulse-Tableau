 100, 1)) + IIF([Calculation_7B496289D1E54156976281CF24BE0953] &gt;= [Calculation_F8F0B233129041E49E64B083B1D85A8A], &quot;% above&quot;, &quot;% below&quot;) + &quot; last year and &quot; + STR(ROUND(ABS([Calculation_7B496289D1E54156976281CF24BE0953] - [Calculation_9E97D1C5CFC247FAB9E8014EA96B412F]) / [Calculation_9E97D1C5CFC247FAB9E8014EA96B412F] * 100, 1)) + IIF([Calculation_7B496289D1E54156976281CF24BE0953] &gt;= [Calculation_9E97D1C5CFC247FAB9E8014EA96B412F], &quot;% above&quot;, &quot;% below&quot;) + &quot; target&quot;"/></column><column caption="PPAC CY" datatype="real" name="[Calculation_7B496289D1E54156976281CF24BE0953]" role="measure" type="quantitative"><calculation class="tableau" formula="[Calculation_B35A0BB545E2416386CE05221FF78F98] / [Calculation_1E720B8617EF465392FECF4DC55FCC03]"/></column><column caption="Max Date" datatype="date" name="[Calculation_B12FF0B282124059A97C0DFA8F4374A6]" role="dimension" type="ordinal"><calculation class="tableau" formula="{FIXED : MAX([Order Date])}"/></column><column caption="PPAC PY" datatype="real" name="[Calculation_F8F0B233129041E49E64B083B1D85A8A]" role="measure" type="quantitative"><calculation class="tableau" formula="[Calculation_BB441E68776A4C3CB186AE7FC507B21A] / [Calculation_74C5F2CBA0514449B17A285C04B28153]"/></column><column caption="PPAC Target" datatype="real" name="[Calculation_9E97D1C5CFC247FAB9E8014EA96B412F]" role="measure" type="quantitative"><calculation class="tableau" formula="[Calculation_F8F0B233129041E49E64B083B1D85A8A] * 1.05"/></column><column name="[Segment]" datatype="string" role="dimension" type="nominal"/><column caption="GP CY" datatype="real" name="[Calculation_B35A0BB545E2416386CE05221FF78F98]" role="measure" type="quantitative"><calculation class="tableau" formula="SUM(IF [Calculation_F9A2BC712D534261BCBE8692145343FE] THEN [Calculation_E34F1150C9F54B13AF3E131A710202D8] END)"/></column><column caption="Active CY" datatype="integer" name="[Calculation_1E720B8617EF465392FECF4DC55FC