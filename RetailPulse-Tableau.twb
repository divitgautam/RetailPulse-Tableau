langana&quot;"/><member value="&quot;Uttar Pradesh&quot;"/><member value="&quot;West Bengal&quot;"/></members></column></datasource-dependencies><datasource-dependencies datasource="federated.0ahyg8e1xelf3914bag3r0yukuro"><column caption="In Segment" datatype="boolean" name="[Calculation_4E10B39DA07E4FA892D7FDC334C752E8]" role="measure" type="nominal"><calculation class="tableau" formula="[Parameters].[Parameter 1] = 'All' OR [Segment] = [Parameters].[Parameter 1]"/></column><column caption="Title KPI" datatype="string" name="[Calculation_8E5143417F234002AEB479ED616AD035]" role="measure" type="nominal"><calculation class="tableau" formula="&quot;PPAC is &quot; + IF ISNULL(([Calculation_A03C372995774FFEAA1C10CB72D37031])) THEN &quot;&quot; ELSEIF ABS(([Calculation_A03C372995774FFEAA1C10CB72D37031])) &gt;= 10000000 THEN &quot;₹&quot; + STR(ROUND(([Calculation_A03C372995774FFEAA1C10CB72D37031]) / 10000000, 2)) + &quot; Cr&quot; ELSEIF ABS(([Calculation_A03C372995774FFEAA1C10CB72D37031])) &gt;= 1000000 THEN &quot;₹&quot; + STR(ROUND(([Calculation_A03C372995774FFEAA1C10CB72D37031]) / 100000, 1)) + &quot; L&quot; ELSEIF ABS(([Calculation_A03C372995774FFEAA1C10CB72D37031])) &gt;= 100000 THEN &quot;₹&quot; + STR(ROUND(([Calculation_A03C372995774FFEAA1C10CB72D37031]) / 100000, 2)) + &quot; L&quot; ELSEIF ABS(([Calculation_A03C372995774FFEAA1C10CB72D37031])) &gt;= 1000 THEN &quot;₹&quot; + STR(INT(INT(ROUND(([Calculation_A03C372995774FFEAA1C10CB72D37031]), 0)) / 1000)) + &quot;,&quot; + RIGHT(&quot;00&quot; + STR(INT(ROUND(([Calculation_A03C372995774FFEAA1C10CB72D37031]), 0)) % 1000), 3) ELSE &quot;₹&quot; + STR(INT(ROUND(([Calculation_A03C372995774FFEAA1C10CB72D37031]), 0))) END + &quot; in &quot; + STR(YEAR(MAX([Calculation_131D7F2062344BD4BBB1ED5C5EA346D7]))) + &quot; YTD: &quot; + STR(ROUND(ABS([Calculation_A03C372995774FFEAA1C10CB72D37031] - [Calculation_2166BEF9AA094B79822F710855A1B2CC]) / [Calculation_2166BEF9AA094B79822F710855A1B2CC] * 100, 1)) + IIF([Calculation_A03C372995774FFEAA1C10CB72D37031] &gt;= [Calculation_2166BEF9AA094B79822F710855A1B2CC], &quot;% above&quot;, &quot;% below&quot;) + &quot; last year and &quot; + STR(ROUND(ABS([Calculation_A03C372995774FFEAA1C10CB72D37031] - [Calculation_7AA697F7E2504F2E8457B629B91006CA]) / [Calculation_7AA697F7E2504F2E8457B629B91006CA] * 100, 1)) + IIF([Calculation_A03C372995774FFEAA1C10CB72D37031] &gt;= [Calculation_7AA697F7E2504F2E8457B629B91006CA], &quot;% above&quot;, &quot;% below&quot;) + &quot; target&quot;"/></column><column caption="PPAC CY" datatype="real" name="[Calculation_A03C372995774FFEAA1C10CB72D37031]" role="measure" type="quantitative"><calculation class="tableau" formula="[Calculation_7AE62AA6ED2D4C52A0F1E3794E9B8562] / [Calculation_E93BC3213A6B4581AC569B8D69657DCC]"/></column><column caption="Max Date" datatype="date" name="[Calculation_131D7F2062344BD4BBB1ED5C5EA346D7]" role="dimension" type="ordinal"><calculation class="tableau" formula="{FIXED : MAX([Order Date])}"/></column><column caption="PPAC PY" datatype="real" name="[Calculation_2166BEF9AA094B79822F710855A1B2CC]" role="measure" type="quantitative"><calculation class="tableau" formula="[Calculation_B455FC12F3164FF2B9D68706F78E207F] / [Calculation_11733B9DD3F64166B451E36471CCEE0F]"/></column><column caption="PPAC Target" datatype="real" name="[Calculation_7AA697F7E2504F2E8457B629B91006CA]" role="measure" type="quantitative"><calculation class="tableau" formula="[Calculation_2166BEF9AA094B79822F710855A1B2CC] * 1.05"/></column><column name="[Segment]" datatype="string" role="dimension" type="nominal"/><column caption="GP CY" datatype="real" name="[Calculation_7AE62AA6ED2D4C52A0F1E3794E9B8562]" role="measure" type="quantitative"><calculation class="tableau" formula="SUM(IF [Calculation_6E2A0499C8A0409E971AF59ABA23E5FE] THEN [Calculation_AC950E9D71AB423099359274A7682F6F] END)"/></column><column caption="Active CY" datatype="integer" name="[Calculation_E93BC3213A6B4581AC569B8D69657DCC]" role="measure" type="quanti