"37111" fixed-size="467" is-fixed="true" type-v2="layout-flow" param="vert"><zone id="30" x="33357" y="59556" w="33357" h="6444" fixed-size="58" is-fixed="true" type-v2="NONE" name="T Segment" show-title="false"><layout-cache type-h="scalable" type-w="scalable"/><zone-style><format attr="border-color" value="#000000"/><format attr="border-style" value="none"/><format attr="border-width" value="0"/></zone-style></zone><zone id="31" x="33357" y="66000" w="33357" h="30667" fixed-size="276" is-fixed="true" type-v2="NONE" name="Repeat Rate by Segment" show-title="false"><layout-cache type-h="scalable" type-w="scalable"/><zone-style><format attr="border-color" value="#000000"/><format attr="border-style" value="none"/><format attr="border-width" value="0"/></zone-style></zone><zone-style><format attr="border-color" value="#000000"/><format attr="border-style" value="none"/><format attr="border-width" value="0"/></zone-style></zone><zone id="32" x="66714" y="59556" w="33286" h="37111" fixed-size="466" is-fixed="true" type-v2="text" forceUpdate="true"><formatted-text><run bold="true" fontalignment="0" fontcolor="#020618" fontsize="11">What this tells us (all customers)
</run><run bold="true" fontalignment="0" fontcolor="#682EFF" fontsize="9">Retention carries profit: </run><run fontalignment="0" fontcolor="#020618" fontsize="9">recurring customers are 53% of buyers but earn 76% of gross profit.
</run><run bold="true" fontalignment="0" fontcolor="#682EFF" fontsize="9">Second orders are slow: </run><run fontalignment="0" fontcolor="#020618" fontsize="9">the median gap is 254 days; 54% return within 2 years. Silence is not churn.
</run><run bold="true" fontalignment="0" fontcolor="#682EFF" fontsize="9">The funnel is empty: </run><run fontalignment="0" fontcolor="#020618" fontsize="9">no sign-ups since 25 Sep 2024, and 80 registered customers never ordered.
</run><run bold="true" fontalignment="0" fontcolor="#682EFF" fontsize="9">Action: </run><run fontalignment="0" fontcolor="#020618" fontsize="9">a second-order nudge for one-time buyers and a first-order offer for the 80.
